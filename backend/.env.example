# Copy this file to .env and replace every placeholder before starting.
DATABASE_URL=sqlite:///./data/monitor.db
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Generate unique values for production. FIELD_ENCRYPTION_KEY must be 64 hex characters.
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FIELD_ENCRYPTION_KEY=replace-with-64-hex-characters
SUPER_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional local one-click updater. Keep the updater outside the web container
# for Docker deployments; native Windows deployments may point this at the app root.
UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/TheLayya/tk_crm/main/version.json
UPDATE_AGENT_URL=http://127.0.0.1:8765
UPDATE_AGENT_TOKEN=
